# Copy to .env on the server and fill in. Never commit .env.
PORT=5002

# MongoDB Atlas connection string (website enquiries + website admin)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/vinalax

# Long random string used to sign website-admin tokens, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# HR software API. On the same EC2 instance use the HR backend's local port.
HR_API_BASE_URL=http://127.0.0.1:5001/api

# Allowed website origins (comma separated). Leave empty to allow all.
CORS_ORIGINS=https://www.vinalaxhrsolutions.com,https://vinalaxhrsolutions.com

# Website admin login (used to create the admin when none exists).
ADMIN_EMAIL=admin@vinalax.com
ADMIN_PASSWORD=
# Set to true for ONE restart to replace the existing admin password, then remove.
ADMIN_RESET_PASSWORD=
